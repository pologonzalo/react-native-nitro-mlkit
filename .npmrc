# Sin esto, pnpm auto-instala el peer `expo: "*"` de cada paquete de packages/*
# con su propio contexto de peers, materializando una SEGUNDA copia de
# expo/expo-asset que expo-doctor marca como node_modules corrupto. Las
# librerías no deben cargar con su propio expo: en runtime lo aporta la app
# (example) y para typecheck los tipos resuelven vía tsconfig.base.json paths.
auto-install-peers=false
dedupe-peer-dependents=true

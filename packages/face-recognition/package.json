{
  "name": "@nitro-mlkit/face-recognition",
  "version": "0.1.0-beta.3",
  "description": "On-device face recognition for React Native — register people, find them in photos. ML Kit detection + a TensorFlow Lite face-embedding model (bring your own, e.g. MobileFaceNet). Nitro/JSI, native batch.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "codegen": "nitrogen",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "nitro",
    "mlkit",
    "face-recognition",
    "face-identification",
    "face-embeddings",
    "mobilefacenet",
    "tensorflow-lite",
    "on-device",
    "expo"
  ],
  "author": "pologonzalo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pologonzalo/react-native-nitro-mlkit.git",
    "directory": "packages/face-recognition"
  },
  "peerDependencies": {
    "expo": "*",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-nitro-modules": ">=0.36.0 <1.0.0"
  },
  "devDependencies": {
    "nitro-codegen": "*",
    "react-native-nitro-modules": "*",
    "typescript": "~5.9.0"
  },
  "files": [
    "src",
    "ios/**/*.swift",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "plugin",
    "expo-module.config.json",
    "nitrogen/generated",
    "*.podspec",
    "nitro.json",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@expo/config-plugins": ">=55.0.0 <58.0.0"
  },
  "homepage": "https://github.com/pologonzalo/react-native-nitro-mlkit/tree/main/packages/face-recognition#readme",
  "bugs": {
    "url": "https://github.com/pologonzalo/react-native-nitro-mlkit/issues"
  }
}

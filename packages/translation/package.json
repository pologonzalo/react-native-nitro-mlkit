{
  "name": "@nitro-mlkit/translation",
  "version": "0.1.0-beta.1",
  "description": "High-performance on-device translation for React Native — Google ML Kit + Nitro. Translate between 50+ languages, all on-device once the model is downloaded.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "codegen": "nitrogen",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "nitro",
    "mlkit",
    "translation",
    "translate",
    "nlp",
    "machine-learning",
    "on-device",
    "expo"
  ],
  "author": "pologonzalo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pologonzalo/react-native-nitro-mlkit.git",
    "directory": "packages/translation"
  },
  "peerDependencies": {
    "expo": "*",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-nitro-modules": ">=0.36.0 <1.0.0"
  },
  "devDependencies": {
    "nitro-codegen": "*",
    "react-native-nitro-modules": "*",
    "typescript": "~5.9.0"
  },
  "files": [
    "src",
    "ios/**/*.swift",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "expo-module.config.json",
    "plugin",
    "app.plugin.js",
    "nitrogen/generated",
    "*.podspec",
    "nitro.json",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/pologonzalo/react-native-nitro-mlkit/tree/main/packages/translation#readme",
  "bugs": {
    "url": "https://github.com/pologonzalo/react-native-nitro-mlkit/issues"
  },
  "dependencies": {
    "@expo/config-plugins": ">=55.0.0 <58.0.0"
  }
}
